{
  "name": "blackbook-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "tsx scripts/build-index.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:live": "BLACKBOOK_AUTO_SYNC=1 npm run start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test src/lib/*.test.ts",
    "sync": "tsx scripts/sync-index.ts",
    "build:index": "BLACKBOOK_BUILD_INDEX=1 tsx scripts/build-index.ts",
    "eval": "tsx scripts/eval-benchmark.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-pgvector": "0.0.18",
    "@huggingface/transformers": "4.3.2",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
